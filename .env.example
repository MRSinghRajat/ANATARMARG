SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# For Google Sign-In (from Google Cloud Console → OAuth Web client)
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Optional: redirect URL for email magic link (OOB). Default: antarmarg://auth-callback
# Add this exact URL to Supabase Dashboard → Auth → URL Configuration → Redirect URLs
# SUPABASE_AUTH_REDIRECT_URL=antarmarg://auth-callback

# OpenAI GPT API (for chat feature)
GPT_API_KEY=sk-proj-your-key-here

# RevenueCat In-App Purchases
# Get your API key from RevenueCat Dashboard → Project → API Keys
REVENUECAT_API_KEY=your_revenuecat_api_key
# The entitlement identifier for premium access
REVENUECAT_ENTITLEMENT_ID=Antar marg Pro
# Set to 'true' for development/testing mode (enables debug logs)
REVENUECAT_DEBUG_MODE=true
