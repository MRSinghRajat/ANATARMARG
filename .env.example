# Copy to `.env` and fill in values (`.env` is gitignored).
# Required for release/TestFlight: `pubspec.yaml` bundles `.env` as an asset—the file must exist at project root.

# ── RevenueCat: Test Store (debug/profile ONLY — never for TestFlight/App Store) ──
# Key starts with test_... — works only in local debug when USE_TEST_STORE=true.
# TestFlight / release builds IGNORE this and require appl_... (iOS) below.
# Dashboard → Apps & providers → Test configuration → Test Store → API key.
REVENUECAT_USE_TEST_STORE=false
REVENUECAT_TEST_STORE_API_KEY=

# ── RevenueCat: Apple / Google PUBLIC SDK keys (required for TestFlight & production) ──
# RevenueCat → Project → API keys → copy the **Apple app** public key (starts with appl_).
# Do NOT paste the Test Store (test_...) key here — Transporter/TestFlight will fail or
# the SDK will report an invalid/wrong API key.
REVENUECAT_API_KEY=
# Recommended for Flutter: set iOS explicitly so you never confuse keys
# REVENUECAT_API_KEY_IOS=appl_xxxxxxxx
# REVENUECAT_API_KEY_ANDROID=goog_xxxxxxxx

# Entitlement identifier as configured in RevenueCat (must match dashboard).
REVENUECAT_ENTITLEMENT_ID=Antar marg Pro
# Optional: second entitlement for AI Guru tier
# REVENUECAT_GURU_ENTITLEMENT_ID=

# Extra SDK logging (verbose). Debug builds also enable LogLevel.debug when kDebugMode.
# REVENUECAT_DEBUG_MODE=true

# ── Premium override (optional) ───────────────────────────────────────
# Default: real Pro only via RevenueCat purchase. Set to true to unlock Pro for everyone (e.g. short beta).
# PREMIUM_GRANT_ALL=true

# ── Legal: HTTPS URLs (required format for RevenueCat paywall + App Store) ──
# RevenueCat Paywall "Terms" / "Privacy" fields need full https:// URLs (in-app browser).
# Flutter route names like /legal/terms do NOT work there — use real hosted pages.
# Optional overrides. Defaults match LegalUrls.defaultTermsOfServiceHttps / defaultPrivacyPolicyHttps.
# LEGAL_TERMS_URL=https://antarmarg.app/legal/terms.html
# LEGAL_PRIVACY_URL=https://antarmarg.app/legal/privacy.html
# Or your own domain after deploying web/legal/*.html:
# LEGAL_TERMS_URL=https://yourdomain.com/legal/terms.html
# LEGAL_PRIVACY_URL=https://yourdomain.com/legal/privacy.html

# ── Aangan temple bell (optional) ─────────────────────────────────────
# Full HTTPS URL to the bell sound (e.g. Supabase Storage public URL). Leave unset for silent bell.
# Only Profile background music is bundled in the app; other audio should use Supabase URLs.
# AANGAN_BELL_AUDIO_URL=
