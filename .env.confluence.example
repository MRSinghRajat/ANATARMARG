# Copy to .env.confluence (gitignored) and fill in.
# Used only by scripts/publish_confluence_overview.py — never read by the app,
# never bundled (not in pubspec.yaml, not in ALLOWED_KEYS in
# scripts/prepare_app_config.py).

CONFLUENCE_BASE_URL=https://yourcompany.atlassian.net/wiki
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=   # https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_SPACE_KEY=AM

# Optional:
# CONFLUENCE_PAGE_TITLE=Antar Marg — Current State Overview
# CONFLUENCE_PARENT_PAGE_ID=   # optional parent page id
# CONFLUENCE_PAGE_ID=          # optional: update existing page by id
